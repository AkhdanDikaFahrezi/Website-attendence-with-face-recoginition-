# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Dapatkan dari: Supabase Dashboard → Project Settings → API

# URL project Supabase Anda
NEXT_PUBLIC_SUPABASE_URL= https://your-project.supabase.co

# Anon/Public key (untuk client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key (untuk server-side ONLY - jangan expose ke browser!)
# Dapatkan dari: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY= your_supabase_service_role_key

# ==========================================
# FLASK BACKEND CONFIGURATION
# ==========================================
# URL Flask backend (lokal untuk development)
# Ganti dengan URL VPS/server saat production
FLASK_API_URL=http://localhost:5001

# ==========================================
# AI CHAT (OPTIONAL)
# ==========================================
# Jika pakai AI chat feature
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ==========================================
# CATATAN PENTING
# ==========================================
# 1. Jangan commit file ini ke git!
# 2. Copy ke .env.local dan isi dengan nilai sebenarnya:
#    cp .env.example .env.local
# 3. .env.local sudah di-gitignore
# 4. SUPABASE_SERVICE_ROLE_KEY jangan pernah expose ke browser/client!
